<?xml version="1.0" encoding="utf-8"?>
<!-- MUI液态玻璃风格导航栏 - 暗黑模式 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- 半透明深色背景 -->
    <solid android:color="#26000000" />
    <!-- 大圆角 -->
    <corners android:radius="24dp" />
    <!-- 白色边框模拟玻璃边缘 -->
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
</shape>
